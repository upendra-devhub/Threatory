# ==============================================================================
# Threatory Backend Environment Variables (.env.example)
# Copy this file to .env for local development. Never commit actual .env files!
# ==============================================================================

# Server port (default: 4000)
PORT=4000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# MongoDB connection URI (e.g. mongodb://localhost:27017/threatory or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/threatory

# Exact frontend origin for CORS and cookie trust (e.g. http://localhost:3000 or https://threatory.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000

# Secret key for cryptographically signing the anonymous owner cookie (minimum 32 characters)
COOKIE_SECRET=replace_with_a_secure_cookie_secret_at_least_32_chars

# Threat feed scheduled synchronization: true | false (default: false)
FEEDS_SYNC_ENABLED=false

# Trust proxy configuration when deployed behind reverse proxy / load balancer (e.g. 'true', '1', or number of hops)
TRUST_PROXY=false

# Optional feed URLs and keys
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
# URLHAUS_FEED_URL=
# URLHAUS_AUTH_KEY=

# DEVELOPMENT ONLY: Fixes the owner ID for local testing.
# STRICT PROHIBITION: This variable MUST NOT be set in production! Server validation fails if set with NODE_ENV=production.
DEV_OWNER_ID=dev-owner-local-test
