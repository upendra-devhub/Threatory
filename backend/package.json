{
  "name": "backend",
  "version": "1.0.0",
  "description": "Threatory Backend API",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "start": "node dist/server.js",
    "seed": "npm run build && node dist/scripts/seed.js",
    "data:tranco": "tsx src/scripts/download-tranco.ts",
    "feeds:sync": "tsx src/scripts/sync-feeds.ts",
    "eval:url": "tsx src/scripts/eval-url.ts"
  },
  "dependencies": {
    "@threatory/contracts": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.0.0",
    "ipaddr.js": "^1.9.1",
    "libphonenumber-js": "^1.13.16",
    "mongoose": "^8.8.1",
    "node-cron": "^4.6.0",
    "p-limit": "^3.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "set-cookie-parser": "^3.2.2",
    "tldts": "^6.1.86",
    "undici": "^8.12.4",
    "validator": "^13.15.35",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@types/pino-http": "^5.8.4",
    "@types/selfsigned": "^2.0.4",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.10",
    "mongodb-memory-server": "^10.1.2",
    "selfsigned": "^5.5.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
