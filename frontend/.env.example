# ==============================================================================
# Threatory Frontend Environment Variables (.env.example)
# Copy this file to .env.local for local development. Never commit actual .env files!
# ==============================================================================

# Backend API origin for Next.js server-side rewrites (/api/:path* -> API_ORIGIN/api/:path*)
# Development: http://localhost:4000
# Production: https://<your-deployed-backend-origin>
API_ORIGIN=http://localhost:4000

# Canonical application URL for metadata and OpenGraph
# Development: http://localhost:3000
# Production: https://<your-deployed-frontend-origin>
NEXT_PUBLIC_APP_URL=http://localhost:3000
