{
  "name": "threatory",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic web security and privacy analyzer",
  "workspaces": [
    "packages/contracts",
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "postinstall": "npm run build -w @threatory/contracts",
    "verify": "npm run build -w @threatory/contracts && npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
